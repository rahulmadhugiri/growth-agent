/* Reset and global styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  /* New Design System Colors */
  --bg-main: #F9F9F9;
  --bg-foreground: #FFFFFF;
  --bg-component: #F0F0F0;
  --bg-component-hover: #E8E8E8;
  --bg-component-active: #E2E2E2;

  --btn-bg: transparent;
  --btn-border: #E5E5E5;
  --btn-hover: #F2F2F2;

  --sidebar-hover: #F2F2F2;
  --sidebar-active: #EDEDED;

  --text-primary: #171717;
  --text-secondary: #666666;

  /* Legacy mapped colors for compatibility */
  --sb-bg: var(--bg-main);
  --sb-border: var(--btn-border);
  --sb-text: var(--text-primary);
  --sb-muted: var(--text-secondary);
  --sb-hover: var(--btn-hover);
  --canvas-bg: var(--bg-component);

  --bg-primary: var(--bg-foreground);
  --bg-secondary: var(--bg-component);
  --border-light: var(--btn-border);
  --text-muted: var(--text-secondary);

  /* Accent colors */
  --accent-blue: #0059ED;
  --accent-blue-hover: #2563eb;
  --accent-blue-light: #eff6ff;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;

  /* Animation timing */
  --t-fast: 140ms;
  --t-med: 220ms;
  --t-slow: 340ms;
  --ease-spring: cubic-bezier(.2,.7,0,1);
  --ease-soft: cubic-bezier(.22,.61,.36,1);

  /* Spacing */
  --space-xs: 4px;
  --space-sm: 12px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 48px;

  /* Border radius */
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);

  /* Animation */
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 300ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 500ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Respect accessibility */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

html, body {
  height: 100%;
  width: 100%;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: var(--text-primary);
  background-color: var(--bg-main);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Main App Layout */
.cursor-app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

/* Top Navigation */
.top-nav {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  height: 64px;
  flex-shrink: 0;
  z-index: 100;
  background-color: var(--bg-main);
}

.nav-center {
  grid-column: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-tabs {
  display: flex;
  gap: var(--space-xs);
  padding: var(--space-xs);
}

.nav-tab {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border: none;
  color: var(--text-secondary);
  font-size: 16px;
  font-weight: 500;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
  background-color: transparent;
}

.nav-tab:hover {
  color: var(--text-primary);
}

.nav-tab.active {
  color: var(--text-primary);
}

.nav-right {
  grid-column: 3;
  display: flex;
  justify-content: flex-end;
  position: relative;
}

/* Profile Avatar & Menu */
.profile-button {
  border: none;
  background: transparent;
  cursor: pointer;
  padding: 0;
  border-radius: 50%;
  transition: all var(--transition-fast);
}

.profile-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: var(--accent-blue);
  color: white;
  font-weight: 600;
  font-size: 14px;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-menu {
  position: absolute;
  top: calc(100% + var(--space-sm));
  right: 0;
  width: 240px;
  background-color: var(--bg-foreground);
  border: 1px solid var(--btn-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  padding: var(--space-md);
  z-index: 1000;
  animation: slideIn 0.2s ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-10px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.profile-menu-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-weight: 600;
  font-size: 14px;
  color: var(--text-primary);
}

.profile-plan {
  font-size: 12px;
  color: var(--text-secondary);
}

.profile-menu-separator {
  height: 1px;
  background-color: var(--btn-border);
  margin: var(--space-md) 0;
}

.profile-menu-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  width: 100%;
  padding: var(--space-sm) var(--space-md);
  border: none;
  background: var(--btn-bg);
  color: var(--text-primary);
  font-size: 14px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.profile-menu-item:hover {
  background-color: var(--btn-hover);
}

.profile-menu-item.danger {
  color: var(--danger);
}

/* Main Content Area */
.main-area {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Codex-Style Agent View */
.codex-agent-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-2xl) var(--space-lg);
  overflow-y: auto;
  background-color: var(--bg-main);
}

.codex-center-content {
  width: 100%;
  max-width: 800px;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* Main Title */
.codex-main-title {
  font-size: 32px;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: var(--space-lg);
}

/* Task Input Container */
.codex-task-input-wrapper {
  width: 100%;
  margin-bottom: var(--space-lg);
}

.codex-task-input-container {
  background-color: var(--bg-foreground);
  border: 1px solid var(--btn-border);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.codex-task-input-container:focus-within {
  border-color: var(--text-primary);
  box-shadow: 0 0 0 2px rgba(23, 23, 23, 0.1);
}

.codex-task-input {
  width: 100%;
  border: none;
  outline: none;
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-primary);
  background: transparent;
  resize: none;
  font-family: inherit;
  min-height: 80px;
  max-height: 200px;
  margin-bottom: var(--space-md);
}

.codex-task-input::placeholder {
  color: var(--text-muted);
}

/* Input Controls */
.codex-input-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding-top: var(--space-md);
}

.codex-control-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  background: var(--btn-bg);
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.codex-control-btn:hover {
  background-color: var(--btn-hover);
  color: var(--text-primary);
}

/* Selectors */
.codex-selectors {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex: 1;
}

.codex-dropdown-wrapper {
  position: relative;
}

.codex-selector-btn {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 6px var(--space-sm);
  border: 1px solid var(--btn-border);
  background-color: var(--btn-bg);
  color: var(--text-primary);
  font-size: 13px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.codex-selector-btn:hover {
  background-color: var(--btn-hover);
  border-color: var(--btn-border);
}

.codex-selector-btn.multiplier {
  min-width: 50px;
  justify-content: center;
}

/* Submit Group */
.codex-submit-group {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.codex-voice-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: none;
  background: var(--btn-bg);
  color: var(--text-secondary);
  border-radius: 50%;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.codex-voice-btn:hover:not(:disabled) {
  background-color: var(--btn-hover);
  color: var(--text-primary);
}

.codex-voice-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.codex-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: none;
  background-color: var(--bg-component);
  color: var(--text-primary);
  border-radius: 50%;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.codex-submit-btn:not(:disabled) {
  background-color: var(--text-primary);
  color: var(--bg-foreground);
}

.codex-submit-btn:hover:not(:disabled) {
  background-color: var(--text-secondary);
  transform: scale(1.05);
}

.codex-submit-btn:disabled {
  cursor: not-allowed;
  opacity: 0.5;
  background-color: var(--bg-component);
  color: var(--text-secondary);
}

/* Tabs */
.codex-tabs-container {
  width: 100%;
  margin-top: var(--space-xl);
}

.codex-tabs {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  border-bottom: 1px solid var(--btn-border);
}

.codex-tab {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-md) var(--space-xs);
  border: none;
  background: var(--btn-bg);
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: color var(--transition-fast);
}

.codex-tab:hover {
  color: var(--text-primary);
}

.codex-tab.active {
  color: var(--text-primary);
}

.tab-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--text-primary);
  margin-right: var(--space-xs);
}

.codex-tab:not(.active) .tab-indicator {
  display: none;
}

/* Task List */
.codex-task-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: var(--space-lg);
}

.codex-task-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-lg);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-fast);
  border-bottom: 1px solid var(--btn-border);
}

.codex-task-item:hover {
  background-color: var(--btn-hover);
}

.codex-task-item:last-child {
  border-bottom: none;
}

.task-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--text-primary);
  margin-top: 6px;
  flex-shrink: 0;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
  line-height: 1.4;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  font-size: 13px;
  color: var(--text-secondary);
}

.task-separator {
  color: var(--text-muted);
}

.loading-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: white;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Dashboard View */
.dashboard-container {
  width: 80%;
  max-width: 1800px;
  margin: 0 auto;
  display: flex;
  height: calc(100vh - 84px); /* Subtract top nav height + margin */
  background-color: var(--bg-foreground);
  overflow: hidden;
  margin-top: 20px;
  border-radius: 14px;
  border: 1px solid var(--btn-border);
}

/* Sidebar */
.dashboard-sidebar {
  width: 240px;
  background-color: var(--bg-foreground);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: var(--space-lg) 0;
  border-right: 1px solid var(--btn-border);
}

.sidebar-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}


.nav-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-lg);
  border: none;
  background: var(--btn-bg);
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--t-fast) var(--ease-soft);
  text-align: left;
  border-radius: 8px;
  margin: 2px var(--space-sm);
}

.nav-item:hover {
  color: var(--text-primary);
  background-color: var(--sidebar-hover);
}

.nav-item.active {
  color: var(--text-primary);
  background-color: var(--sidebar-active);
}

/* Main Content */
.dashboard-main {
  flex: 1;
  padding: var(--space-xl);
  overflow-y: auto;
  background-color: var(--bg-main);
}

.content-header {
  margin-bottom: var(--space-2xl);
}

.content-header h1 {
  font-size: 24px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.content-header p {
  font-size: 14px;
  color: var(--text-secondary);
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--space-xl);
  margin-bottom: var(--space-2xl);
}

.stat-card {
  background-color: var(--bg-foreground);
  border: 1px solid var(--btn-border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
}

.stat-value {
  font-size: 28px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.stat-label {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: var(--space-sm);
}

.stat-change {
  display: inline-block;
  padding: 2px var(--space-sm);
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 500;
}

.stat-change.positive {
  background-color: #dcfce7;
  color: var(--success);
}

.stat-change.negative {
  background-color: #fef2f2;
  color: var(--danger);
}

.stat-change.neutral {
  background-color: var(--bg-secondary);
  color: var(--text-secondary);
}

/* Dashboard Content */
.dashboard-content {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: var(--space-2xl);
  margin-top: var(--space-2xl);
}

.recent-activity-card,
.engagement-card {
  background-color: var(--bg-foreground);
  border: 1px solid var(--btn-border);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
}

.recent-activity-card h2,
.engagement-card h2 {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-lg);
}

.recent-items {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.recent-item {
  padding: var(--space-sm) 0;
}

.item-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.item-meta {
  display: flex;
  gap: var(--space-md);
  font-size: 12px;
  color: var(--text-secondary);
}

.item-type {
  color: var(--accent-blue);
}

.engagement-chart {
  height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-placeholder {
  text-align: center;
  color: var(--text-muted);
}

.chart-icon {
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

@media (max-width: 1024px) {
  .dashboard-content {
    grid-template-columns: 1fr;
  }
}

.dashboard-header {
  margin-bottom: var(--space-2xl);
}

.dashboard-header h1 {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: var(--space-sm);
  color: var(--text-primary);
}

.dashboard-header p {
  font-size: 16px;
  color: var(--text-secondary);
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-lg);
  margin-bottom: var(--space-2xl);
}

.stat-card {
  background-color: var(--bg-foreground);
  border: 1px solid var(--btn-border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--text-secondary);
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.stat-label {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: var(--space-sm);
}

.stat-change {
  font-size: 12px;
  font-weight: 600;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  display: inline-block;
}

.stat-change.positive {
  background-color: #dcfce7;
  color: var(--success);
}

.stat-change.negative {
  background-color: #fef2f2;
  color: var(--danger);
}

.stat-change.neutral {
  background-color: var(--bg-secondary);
  color: var(--text-secondary);
}

/* Dashboard Content */
.dashboard-content {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: var(--space-2xl);
  margin-top: var(--space-2xl);
}

@media (max-width: 1024px) {
  .dashboard-content {
    grid-template-columns: 1fr;
  }
}

.recent-activity-card,
.engagement-card {
  background-color: var(--bg-foreground);
  border: 1px solid var(--btn-border);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
}

.recent-activity-card h2,
.engagement-card h2 {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: var(--space-lg);
  color: var(--text-primary);
}

.recent-items {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.recent-item {
  padding: var(--space-md);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.recent-item:hover {
  background-color: var(--btn-hover);
}

.item-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.item-meta {
  display: flex;
  gap: var(--space-md);
  font-size: 12px;
  color: var(--text-secondary);
}

.item-type {
  background-color: var(--bg-component);
  color: var(--text-primary);
  padding: 2px var(--space-sm);
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.engagement-chart {
  height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-placeholder {
  text-align: center;
  color: var(--text-muted);
}

.chart-icon {
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

/* Responsive Design */
@media (max-width: 768px) {
  .top-nav {
    padding: var(--space-md);
  }
  
  .nav-tabs {
    gap: 0;
  }
  
  .nav-tab {
    font-size: 12px;
    padding: var(--space-sm);
  }
  
  .chat-history {
    padding: var(--space-md);
  }
  
  .chat-input-container {
    padding: var(--space-md);
  }
  
  .dashboard-view {
    padding: var(--space-md);
  }
  
  .stats-grid {
    grid-template-columns: 1fr;
  }
  
  .dashboard-content {
    grid-template-columns: 1fr;
  }
}

/* Scrollbar Styling */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background-color: var(--border-medium);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background-color: var(--text-muted);
}

/* Focus styles for accessibility */
.nav-tab:focus-visible,
.profile-button:focus-visible,
.profile-menu-item:focus-visible,
.chat-input:focus-visible,
.chat-submit-btn:focus-visible {
  outline: 2px solid var(--accent-blue);
  outline-offset: 2px;
}